# Copy this file to .env and fill in your own local credentials.
# NEVER commit .env or paste access tokens into chat/issues.
UPSTOX_ACCESS_TOKEN=replace_with_your_own_upstox_access_token

# Optional: backend URL used by the Next.js rewrite.
# Keep the API bound to 127.0.0.1 for local development.
BHARATMARKET_API_URL=http://127.0.0.1:8000
